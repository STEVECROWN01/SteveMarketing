# =====================================================================
# STEVENS AKPOVI — SITE WEB PROFESSIONNEL
# Modèle des variables d'environnement (documenté, sans valeur secrète)
#
# En production sur Vercel : Project Settings → Environment Variables
# (ne jamais committer de vraies valeurs secrètes — .env* est ignoré).
# Guide complet : voir DEPLOIEMENT.md
# =====================================================================

# --- Base de données (développement local) ---------------------------
# SQLite local. En production sur Vercel, le système de fichiers n'est
# pas persistant : les demandes sont relayées par email (RESEND_API_KEY)
# et une base managée peut être branchée — voir DEPLOIEMENT.md §5.
DATABASE_URL="file:./db/custom.db"

# --- URL canonique du site --------------------------------------------
# Utilisée pour : canonical, sitemap.xml, Open Graph, JSON-LD.
# En production, mettre l'URL finale réelle du déploiement, ex. :
# NEXT_PUBLIC_SITE_URL="https://stevemarketing.vercel.app"
NEXT_PUBLIC_SITE_URL="https://stevens-akpovi.vercel.app"

# --- Calendly -----------------------------------------------------------
# Rendez-vous stratégique de 30 minutes (confirmé par l'éditeur) —
# événement réel /30min du compte stevensakpovi. L'URL /20min
# mentionnée dans le cahier des charges renvoie 404.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/stevensakpovi/30min"

# --- Notifications email (Resend) — DEMANDES DES VISITEURS UNIQUEMENT
# (volet 30) : aucun document du back-office n'est plus envoyé par
# email, tout est archivé dans le dépôt GitHub privé. -----------------
# Active la notification des demandes à stevensakpovi@gmail.com ainsi que
# l'accusé de réception au visiteur. Créer une clé sur https://resend.com
# (forfait gratuit disponible). Tant qu'elle n'est pas définie, les demandes
# sont conservées en base de données locale uniquement.
RESEND_API_KEY=""

# --- Espace administrateur (page #/admin) ------------------------------
# Mot de passe de connexion et secret de signature des sessions (HMAC).
# ADMIN_PASSWORD suffit (volet 14) : sans ADMIN_SESSION_SECRET, le
# secret de session est DÉRIVÉ du mot de passe — la connexion marche
# avec le seul mot de passe défini. Un secret explicite (>= 16
# caractères) reste possible pour l'invalider indépendamment.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# --- Back-office : stockage des documents (volet 14, 24/11/2026) -------
# Les propositions, devis et factures générés sont archivés en JSON
# dans le dossier documents/ d'un DÉPÔT PRIVÉ DÉDIÉ
# (STEVECROWN01/SteveMarketing-Documents) via l'API GitHub — aucune
# base de données payante (Railway, Supabase…) n'est nécessaire.
# GITHUB_DOCS_TOKEN : jeton d'accès GitHub (portée « repo ») de
# l'éditeur. Sans cette variable, la GÉNÉRATION fonctionne (PDF,
# téléchargement) ; seul l'archivage est en attente.
GITHUB_DOCS_TOKEN=""
# Optionnels — valeurs par défaut ci-dessous :
# GITHUB_DOCS_REPO="STEVECROWN01/SteveMarketing-Documents"
# GITHUB_DOCS_BRANCH="main"

# --- Mentions légales ----------------------------------------------------
# Identifiant professionnel de l'éditeur (IFU, RCCM…), affiché tel quel
# dans les mentions légales dès qu'il est renseigné. Ex. :
# NEXT_PUBLIC_LEGAL_REGISTRATION="N° IFU : 1234567890 — Cotonou, Bénin"
NEXT_PUBLIC_LEGAL_REGISTRATION=""

# --- Outils Google (volet 8 de l'audit, 19/11/2026) ----------------------
# Search Console : valeur content de la balise HTML de validation (pas la
# balise entière). Rend <meta name="google-site-verification"> si définie.
# Procédure complète dans DEPLOIEMENT.md §3.
NEXT_PUBLIC_GSC_VERIFICATION=""
# Google Analytics 4 : identifiant de mesure G-XXXXXXXXXX. Charge les
# scripts gtag.js si défini — sinon aucune requête vers Google.
# Pensez à mettre à jour #/mentions-legales si vous l'activez.
NEXT_PUBLIC_GA_ID=""
