# =====================================================================
# STEVENS AKPOVI — SITE WEB PROFESSIONNEL
# Modèle des variables d'environnement (documenté, sans valeur secrète)
#
# En production sur Vercel : Project Settings → Environment Variables
# (ne jamais committer de vraies valeurs secrètes — .env* est ignoré).
# Guide complet : voir DEPLOIEMENT.md
# =====================================================================

# --- Base de données (développement local) ---------------------------
# SQLite local. En production sur Vercel, le système de fichiers n'est
# pas persistant : les demandes sont relayées par email (RESEND_API_KEY)
# et une base managée peut être branchée — voir DEPLOIEMENT.md §5.
DATABASE_URL="file:./db/custom.db"

# --- URL canonique du site --------------------------------------------
# Utilisée pour : canonical, sitemap.xml, Open Graph, JSON-LD.
# En production, mettre l'URL finale réelle du déploiement, ex. :
# NEXT_PUBLIC_SITE_URL="https://stevemarketing.vercel.app"
NEXT_PUBLIC_SITE_URL="https://stevens-akpovi.vercel.app"

# --- Calendly -----------------------------------------------------------
# Rendez-vous stratégique de 30 minutes (confirmé par l'éditeur) —
# événement réel /30min du compte stevensakpovi. L'URL /20min
# mentionnée dans le cahier des charges renvoie 404.
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/stevensakpovi/30min"

# --- Notifications email (Resend) --------------------------------------
# Active la notification des demandes à stevensakpovi@gmail.com ainsi que
# l'accusé de réception au visiteur. Créer une clé sur https://resend.com
# (forfait gratuit disponible). Tant qu'elle n'est pas définie, les demandes
# sont conservées en base de données locale uniquement.
RESEND_API_KEY=""

# --- Espace administrateur (page #/admin) ------------------------------
# Mot de passe de connexion et secret de signature des sessions (HMAC).
# Générer des valeurs fortes, ex. : openssl rand -hex 32
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# --- Mentions légales ----------------------------------------------------
# Identifiant professionnel de l'éditeur (IFU, RCCM…), affiché tel quel
# dans les mentions légales dès qu'il est renseigné. Ex. :
# NEXT_PUBLIC_LEGAL_REGISTRATION="N° IFU : 1234567890 — Cotonou, Bénin"
NEXT_PUBLIC_LEGAL_REGISTRATION=""
